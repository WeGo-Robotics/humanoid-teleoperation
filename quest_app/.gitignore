# Unity working directories -- all regenerated from Assets/ + Packages/.
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Generated by QuestBuild at build time, not authored. See the header of
# TeleopBootstrap for why the scene is code rather than a committed asset.
/Assets/Scenes/
/Assets/Scenes.meta
/Assets/XR/
/Assets/XR.meta

# Written into Assets/ by the Meta SDK during a build, not authored. Same
# reasoning as Assets/Scenes above: it is an output of building, and committing
# it would mean every build shows up as a source change.
/Assets/StreamingAssets/
/Assets/StreamingAssets.meta

# Scratch directory the Meta SDK creates on import and leaves empty.
/Assets/Oculus/
/Assets/Oculus.meta

# Package lock: the Meta registry pins exact versions in manifest.json already,
# and the lock file churns on every editor open.
/Packages/packages-lock.json

# IDE / build leftovers
*.csproj
*.sln
*.user
*.pidb
*.booproj
*.svd
*.unityproj
.vs/
.idea/
*.apk.meta
crashlytics-build.properties
